{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:compilableworld-intake-plan-v0-1",
  "title": "AWA CompilableWorld Intake Plan v0.1",
  "type": "object",
  "required": ["contract", "intake_id", "world", "required_composition_modules", "graph_roots", "runtime_modules", "rooms", "exits", "entities", "items", "quests", "scenarios"],
  "properties": {
    "contract": {"const": "compilableworld-intake-plan.v0.1"},
    "intake_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$"},
    "world": {
      "type": "object",
      "required": ["world_id", "world_version", "schema_version", "namespace", "title", "default_language", "player_spawn", "default_player_entity"],
      "properties": {
        "world_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "world_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "namespace": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "default_language": {"type": "string", "minLength": 2},
        "player_spawn": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "default_player_entity": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}
      },
      "additionalProperties": false
    },
    "required_composition_modules": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "graph_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "runtime_modules": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "rooms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["room_id", "name", "description", "region"],
        "properties": {
          "room_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "region": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}
        }, "additionalProperties": false
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exit_id", "from_room", "to_room", "direction", "bidirectional"],
        "properties": {
          "exit_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "from_room": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "to_room": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "direction": {"type": "string", "minLength": 1},
          "bidirectional": {"type": "boolean"}
        }, "additionalProperties": false
      }
    },
    "entities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtime_entity_id", "semantic_ref", "entity_type", "room", "components", "health"],
        "properties": {
          "runtime_entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "semantic_ref": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "room": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "components": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "health": {"type": ["integer", "null"], "minimum": 1}
        }, "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "name", "room", "portable", "provenance"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "name": {"type": "string", "minLength": 1},
          "room": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "portable": {"type": "boolean"},
          "provenance": {"type": "string", "minLength": 1}
        }, "additionalProperties": false
      }
    },
    "quests": {"type": "array", "items": {"type": "object"}},
    "scenarios": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
