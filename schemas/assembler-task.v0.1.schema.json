{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:assembler-task-v0-1",
  "title": "AWA Bounded Assembler Task v0.1",
  "description": "One bounded candidate-generation/repair task over already-governed AWA inputs.",
  "type": "object",
  "required": ["contract","task_id","generation_task","context_refs","capability_id","target","validators","repair_policy","promotion_policy","authority"],
  "properties": {
    "contract": {"const": "assembler-task.v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "generation_task": {"type": "object"},
    "context_refs": {
      "type": "object",
      "required": ["semantic_snapshot_sha256","composition_receipt_id","graph_snapshot_id","presentation_binding_id"],
      "properties": {
        "semantic_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "composition_receipt_id": {"type": "string", "minLength": 1},
        "graph_snapshot_id": {"type": "string", "minLength": 1},
        "presentation_binding_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "capability_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["layer","node_id","kind","filename","mime_type","version"],
      "properties": {
        "layer": {"enum": ["semantic","composition","asset","runtime","presentation"]},
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "mime_type": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v\\d+\\.\\d+$"}
      },
      "additionalProperties": false
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repair_policy": {
      "type": "object",
      "required": ["max_attempts"],
      "properties": {"max_attempts": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "promotion_policy": {
      "type": "object",
      "required": ["target_status","canonical_write"],
      "properties": {
        "target_status": {"const": "validated_candidate"},
        "canonical_write": {"const": false}
      },
      "additionalProperties": false
    },
    "authority": {"const": "proposal"}
  },
  "additionalProperties": false
}
