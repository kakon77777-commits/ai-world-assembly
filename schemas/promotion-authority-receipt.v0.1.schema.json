{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:promotion-authority-receipt-v0-1",
  "title": "AWA Promotion Authority Receipt v0.1",
  "description": "Verification evidence that a grant matches an exact ready selection; Phase 13 still performs no canonical write.",
  "type": "object",
  "required": ["contract", "authorization_id", "status", "authority", "readiness_evidence_hash", "grant_hash", "policy_id", "policy_sha256", "slot_id", "candidate_id", "candidate_sha256", "canonical_write", "reason", "evidence_hash"],
  "properties": {
    "contract": {"const": "promotion-authority-receipt.v0.1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "status": {"const": "promotion_authorized"},
    "authority": {"const": "promotion_verification"},
    "readiness_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grant_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slot_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_write": {"const": false},
    "reason": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
