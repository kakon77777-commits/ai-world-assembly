{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:awa:schema:alien-lineage-runtime-slice-v0-1",
  "title":"Alien Lineage Runtime Slice v0.1",
  "type":"object",
  "required":["contract","slice_id","runtime_module","runtime_config","functions"],
  "properties":{
    "contract":{"const":"alien-lineage-runtime-slice.v0.1"},
    "slice_id":{"type":"string","pattern":"^[a-z][a-z0-9_.:-]*$"},
    "runtime_module":{
      "type":"object",
      "required":["module_id","version","entrypoint"],
      "properties":{
        "module_id":{"const":"alien_lineage.runtime"},
        "version":{"const":"0.1.0"},
        "entrypoint":{"const":"awa_alien_lineage.runtime:AlienLineageModule"}
      },"additionalProperties":false
    },
    "runtime_config":{
      "type":"object",
      "required":["species_ref","stages","adult_stage","hatch_stage","organs","resource_defaults","rifts"],
      "properties":{
        "species_ref":{"type":"string","minLength":1},
        "stages":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"},"minItems":2,"uniqueItems":true},
        "adult_stage":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"},
        "hatch_stage":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"},
        "organs":{"type":"array","minItems":1,"items":{"type":"object","required":["organ_id","tier"],"properties":{"organ_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"},"tier":{"type":"integer","minimum":1,"maximum":16}},"additionalProperties":false}},
        "resource_defaults":{"type":"object","additionalProperties":{"type":"integer","minimum":1,"maximum":100000}},
        "rifts":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"}}
      },"additionalProperties":false
    },
    "functions":{
      "type":"object","required":["functions"],
      "properties":{"functions":{"type":"array","minItems":4,"items":{"type":"object"}}},
      "additionalProperties":false
    }
  },"additionalProperties":false
}
