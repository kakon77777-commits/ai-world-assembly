{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:multi-world-orchestration-plan-v0-1",
  "title": "AWA Multi-World Orchestration Plan v0.1",
  "description": "Reviewed coordination plan over independent bounded assembler tasks. Coordination does not merge child authority or grant canonical writes.",
  "type": "object",
  "required": ["contract","plan_id","authority","project_state_ref","execution_policy","tasks"],
  "properties": {
    "contract": {"const": "multi-world-orchestration-plan.v0.1"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "authority": {"const": "coordination"},
    "project_state_ref": {"type": "string", "minLength": 1},
    "execution_policy": {
      "type": "object",
      "required": ["max_parallel","max_tasks","max_total_attempts","fail_fast"],
      "properties": {
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_tasks": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_total_attempts": {"type": "integer", "minimum": 1, "maximum": 256},
        "fail_fast": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["orchestration_task_id","world_scope","task_ref","context","depends_on","write_claims"],
        "properties": {
          "orchestration_task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "world_scope": {"type": "string", "pattern": "^game\\.[a-z0-9_]+$"},
          "task_ref": {"type": "string", "minLength": 1},
          "context": {
            "type": "object",
            "required": ["semantic_snapshot","composition_receipt","presentation_binding","capability_contract","nodes","edges","artifacts","validations"],
            "properties": {
              "semantic_snapshot": {"type": "string", "minLength": 1},
              "composition_receipt": {"type": "string", "minLength": 1},
              "presentation_binding": {"type": "string", "minLength": 1},
              "capability_contract": {"type": "string", "minLength": 1},
              "nodes": {"type": "string", "minLength": 1},
              "edges": {"type": "string", "minLength": 1},
              "artifacts": {"type": "string", "minLength": 1},
              "validations": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          },
          "write_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["scope","key"],
              "properties": {
                "scope": {"enum": ["world","shared"]},
                "key": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
