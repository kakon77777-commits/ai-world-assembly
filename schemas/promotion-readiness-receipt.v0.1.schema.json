{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:promotion-readiness-receipt-v0-1",
  "title": "AWA Promotion Readiness Receipt v0.1",
  "description": "Deterministic selection/readiness evidence without promotion authority or canonical write.",
  "type": "object",
  "required": ["contract", "readiness_id", "conflict_set_id", "policy_id", "status", "authority", "source_hashes", "decisions", "ready_candidates", "promotion_authority_required", "canonical_write", "evidence_hash"],
  "properties": {
    "contract": {"const": "promotion-readiness-receipt.v0.1"},
    "readiness_id": {"type": "string", "minLength": 1},
    "conflict_set_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "authority": {"const": "readiness_evaluation"},
    "source_hashes": {
      "type": "object",
      "required": ["conflict_set", "policy"],
      "properties": {
        "conflict_set": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot_id", "claim", "world_scopes", "candidate_ids", "conflict", "decision", "selected_candidate", "ranking", "reason"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "claim": {
            "type": "object",
            "required": ["scope", "key"],
            "properties": {
              "scope": {"enum": ["world", "shared"]},
              "key": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "world_scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "conflict": {"type": "boolean"},
          "decision": {"enum": ["uncontested", "selected", "blocked_tie"]},
          "selected_candidate": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["candidate_id", "world_scope", "candidate_sha256"],
                "properties": {
                  "candidate_id": {"type": "string", "minLength": 1},
                  "world_scope": {"type": "string", "minLength": 1},
                  "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "additionalProperties": false
              }
            ]
          },
          "ranking": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["candidate_id", "values"],
              "properties": {
                "candidate_id": {"type": "string", "minLength": 1},
                "values": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
              },
              "additionalProperties": false
            }
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "ready_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "world_scope", "candidate_sha256"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "world_scope": {"type": "string", "minLength": 1},
          "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "promotion_authority_required": {"const": true},
    "canonical_write": {"const": false},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
