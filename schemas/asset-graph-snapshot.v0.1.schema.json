{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awa:schema:asset-graph-snapshot-v0-1",
  "title": "AWA Asset Graph Snapshot v0.1",
  "description": "Deterministic required-build closure snapshot for one or more graph roots.",
  "type": "object",
  "required": [
    "contract",
    "snapshot_id",
    "roots",
    "required_closure",
    "missing_required",
    "generation_task_ids",
    "artifact_statuses",
    "source_hashes",
    "sha256"
  ],
  "properties": {
    "contract": {"const": "asset-graph-snapshot.v0.1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_closure": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "missing_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "from", "to", "scope", "version_constraint"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "version_constraint": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "generation_task_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "artifact_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "artifact_id",
          "sha256",
          "effective_status",
          "fresh_validation_ids",
          "stale_validation_ids"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "effective_status": {
            "type": "string",
            "enum": ["passed", "failed", "stale", "unvalidated"]
          },
          "fresh_validation_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "stale_validation_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "source_hashes": {
      "type": "object",
      "required": ["nodes", "edges", "artifacts", "validations"],
      "properties": {
        "nodes": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "edges": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validations": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
