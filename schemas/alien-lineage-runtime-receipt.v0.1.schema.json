{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:awa:schema:alien-lineage-runtime-receipt-v0-1",
  "title":"Alien Lineage Runtime Receipt v0.1",
  "type":"object",
  "required":["contract","receipt_id","slice_id","base_intake_receipt_id","runtime_module","source_hashes","output_hashes","authoring_sha256"],
  "properties":{
    "contract":{"const":"alien-lineage-runtime-receipt.v0.1"},
    "receipt_id":{"type":"string","pattern":"^alien-runtime:[a-z0-9_.:-]+:[0-9a-f]{16}$"},
    "slice_id":{"type":"string","minLength":1},
    "base_intake_receipt_id":{"type":"string","minLength":1},
    "runtime_module":{"type":"object","required":["module_id","version","entrypoint"],"properties":{"module_id":{"type":"string"},"version":{"type":"string"},"entrypoint":{"type":"string"}},"additionalProperties":false},
    "source_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "output_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "authoring_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },"additionalProperties":false
}
